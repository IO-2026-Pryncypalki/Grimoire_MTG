{
  "name": "grimoire_mtg",
  "version": "1.0.0",
  "description": "Mobile app for scanning Magic: The Gathering cards and building decks effortlessly.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "start": "ts-node src/backend/index.ts",
    "dev": "nodemon src/backend/index.ts",
    "migrate:up": "dotenv -e .env -- node --import tsx ./node_modules/.bin/node-pg-migrate up",
    "migrate:down": "dotenv -e .env -- node --import tsx ./node_modules/.bin/node-pg-migrate down",
    "migrate:create": "dotenv -e .env -- node-pg-migrate create --migrations-dir migrations --extension ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IO-2026-Pryncypalki/Grimoire_MTG.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/IO-2026-Pryncypalki/Grimoire_MTG/issues"
  },
  "homepage": "https://github.com/IO-2026-Pryncypalki/Grimoire_MTG#readme",
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/node-pg-migrate": "^2.3.1",
    "@types/ws": "^8.5.14",
    "dotenv-cli": "^11.0.0",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "setupFiles": [
      "./jest.setup.ts"
    ]
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "jsonwebtoken": "^9.0.3",
    "node-pg-migrate": "^8.0.4",
    "node-symspell": "^0.1.0",
    "nodemon": "^3.1.14",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "sequelize": "^6.37.8",
    "supertest": "^7.2.2",
    "ws": "^8.18.0"
  }
}
