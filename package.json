{
  "name": "grimoire_mtg",
  "version": "1.0.0",
  "description": "Mobile app for scanning Magic: The Gathering cards and building decks effortlessly.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "migrate:up":     "dotenv -e .env -- node-pg-migrate up",
    "migrate:down":   "dotenv -e .env -- node-pg-migrate down",
    "migrate:create": "dotenv -e .env -- node-pg-migrate create --migrations-dir migrations"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IO-2026-Pryncypalki/Grimoire_MTG.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/IO-2026-Pryncypalki/Grimoire_MTG/issues"
  },
  "homepage": "https://github.com/IO-2026-Pryncypalki/Grimoire_MTG#readme",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "@types/node-pg-migrate": "^2.3.1",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    }
  },
  "dependencies": {
    "node-pg-migrate": "^8.0.4"
  }
}
