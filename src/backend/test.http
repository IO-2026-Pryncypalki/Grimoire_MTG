### 1. Tworzenie nowej talii
POST {{baseUrl}}/decks
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Talia Testowa",
  "format": "Standard"
}

> {%
    if (response.status === 201) {
        client.global.set("deckId", response.body.id);
        client.log("\n========== KROK 1: TWORZENIE TALII ==========");
        client.log(JSON.stringify(response.body, null, 2));
    }
%}

### 2. Dodawanie kart do talii (4 sztuki)
POST {{baseUrl}}/decks/{{deckId}}/cards
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "scryfallId": "{{scryfallId}}",
  "quantity": 4,
  "board": "main"
}

> {%
    client.log("\n========== KROK 2: DODANIE KART ==========");
    client.log(JSON.stringify(response.body, null, 2));
%}

### 3. Wypisanie szczegółów talii (z dodanymi kartami)
GET {{baseUrl}}/decks/{{deckId}}
Authorization: Bearer {{token}}

> {%
    client.log("\n========== KROK 3: SPRAWDZENIE TALII ==========");
    client.log(JSON.stringify(response.body, null, 2));
%}

### 4. Zmniejszenie ilości karty (Usuwamy tylko 1 sztukę z 4)
DELETE {{baseUrl}}/decks/{{deckId}}/cards/{{scryfallId}}?board=main&quantity=1
Authorization: Bearer {{token}}

> {%
    client.log("\n========== KROK 4: USUNIĘCIE 1 SZTUKI (Zostały 3) ==========");
    client.log(JSON.stringify(response.body, null, 2));
%}


