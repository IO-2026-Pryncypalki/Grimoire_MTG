### 6. Całkowite usunięcie karty z talii (Wyrzucamy resztę)
DELETE {{baseUrl}}/decks/{{deckId}}/cards/{{scryfallId}}?board=main
Authorization: Bearer {{token}}

> {%
    client.log("\n========== KROK 6: CAŁKOWITE USUNIĘCIE KARTY ==========");
    // Ten endpoint pewnie nie zwraca całej talii, tylko status OK, ale i tak wypisujemy loga
    client.log(JSON.stringify(response.body, null, 2));
%}

